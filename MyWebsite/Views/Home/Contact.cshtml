@{
    ViewData["Title"] = "Contact"; 
}

<div>
    <h2>Contact Me</h2>
    <ul>
        @* we will loop through the model (dictionary) to display the information *@
        @foreach (KeyValuePair<string, string> contact in Model)
        {
            <li><strong>@contact.Key</strong> @contact.Value</li>
        }
    </ul>
</div>

