@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    @* Addefd header for main help page *@
    <H1>Help Page!</H1>
    <nav>
        <ul class="nav nav-tabs">
            <li class="nav-item">
                @* Nav link to home page (index) for help area *@
                <a class="nav-link @(ViewData["Title"] == "Home" ? "active" : "")" asp-area="Help" asp-controller="Home" asp-action="Index">Home</a>
            </li>
        @* Nav link to tutorial page (page1) for help area *@
            <li class="nav-item">
                <a class="nav-link @(((string)ViewData["Title"]).Contains("Tutorial") ? "active" : "")" asp-area="Help" asp-controller="Tutorial" asp-action="Page1">Tutorial</a>
            </li>
        </ul>
    </nav>

    <div class="container">
            @RenderBody()
    </div>
