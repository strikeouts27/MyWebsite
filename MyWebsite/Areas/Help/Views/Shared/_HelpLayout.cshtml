<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyWebsite</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyWebsite.styles.css" asp-append-version="true" />  
    @* <link rel="stylesheet" href="~/css/tutorialarea.css" asp-append-version="true" /> *@
</head>



<body>
<!-- About --> 
<!--asp- action specifies which action method will be utlized.  -->
    <header>
        <nav class="navbar navbar-dark bg-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MyWebsite</a>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Help" asp-controller="Home" asp-action="Index">My Website</a>
                    </li> 
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Help" asp-controller="Home" asp-action="Index">Home</a>
                    </li> 
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Help" asp-controller="Home" asp-action="Index">About</a>
                    </li> 
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Help" asp-controller="Home" asp-action="Index">Contact</a>
                    </li> 

                    <li class="nav-item">
                        <a class="nav-link" asp-area="Help" asp-controller="Home" asp-action="Index">Help</a>
                    </li>      
                </ul>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MyWebsite
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>